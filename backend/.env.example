NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://hrms:hrms@localhost:5432/hrms
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Failed logins and refreshes allowed per client address within the window before the API answers 429.
# RATE_LIMIT_WINDOW=15m
# LOGIN_RATE_LIMIT_MAX=10
# REFRESH_RATE_LIMIT_MAX=30
# Number of reverse proxies in front of the API. Leave at 0 unless there is one: it decides whether
# X-Forwarded-For is believed when telling clients apart.
# TRUST_PROXY_HOPS=0
# Integration tests use their own database, created and emptied on every run. The name must end with _test.
# TEST_DATABASE_URL=postgresql://hrms:hrms@localhost:5432/hrms_test
# First admin, created by `npm run db:seed -w backend`. Set both or neither. The password needs at least 12
# characters (at most 72 bytes). An existing account is never changed, so these can be removed afterwards.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password
