NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://hrms:hrms@localhost:5432/hrms
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# First admin, created by `npm run db:seed -w backend`. Set both or neither. The password needs at least 12
# characters (at most 72 bytes). An existing account is never changed, so these can be removed afterwards.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password
